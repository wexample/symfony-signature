{
  "name": "wexample/symfony-signature",
  "description": "Electronic signature of an envelope — documents of the media library and data, sealed by their fingerprint — by accounts or outside signers, chained, timestamped (RFC 3161) and verifiable",
  "version": "2.0.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonySignature\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonySignature\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^2.13 || ^3.0",
    "symfony/console": "^7.4 || ^8.0",
    "symfony/event-dispatcher": "^7.4 || ^8.0",
    "symfony/http-client": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/routing": "^7.4 || ^8.0",
    "symfony/uid": "^7.4 || ^8.0",
    "wexample/symfony-helpers": ">=16.0.0",
    "wexample/symfony-mail": ">=2.0.0",
    "wexample/symfony-media": ">=2.0.0",
    "wexample/symfony-notification": ">=2.0.0",
    "wexample/symfony-activity": ">=3.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=2.0.0",
    "symfony/browser-kit": "^7.4 || ^8.0",
    "symfony/security-bundle": "^7.4 || ^8.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}